# Runtime values are entered manually in each Worker's dashboard.
# Never copy deployment or token-management credentials into runtime variables.
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
CF_USAGE_API_TOKEN=replace-with-this-environments-readonly-usage-token
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
APP_ENV=test
PROCESSING_ENABLED=false
