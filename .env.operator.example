# Optional operator input for scripts/provision.py and scripts/builds.py.
# Copy to .env, replace values, chmod 600 .env, or set CF_VIDEO_ENV_FILE to a
# private file outside this checkout. Process environment overrides the file.
# These credentials are NOT runtime bindings and must never be put in Vite.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-account-id
CF_TOKEN_MANAGER_API_TOKEN=replace-with-your-token-management-token
# Needed only when CF_VIDEO_ZONE_NAME is set:
# CLOUDFLARE_API_TOKEN=replace-with-your-zone-read-token
# CF_VIDEO_ZONE_NAME=example.com
# CF_VIDEO_PROJECT_NAME=cf-video-hub
# CF_VIDEO_WORKER_NAME=cf-video-hub-test
# CF_VIDEO_DATABASE_NAME=cf-video-hub-test
# CF_VIDEO_BUCKET_NAME=cf-video-hub-test
# CF_VIDEO_LOCATION=apac
# CF_VIDEO_REPOSITORY=your-github-user/cf-video-studio
# CF_VIDEO_BRANCH=main
# CF_VIDEO_TOKEN_EXPIRES_ON=replace-with-an-ISO-8601-expiry
# Do not prefill generated CF_DEPLOY_API_TOKEN, CF_USAGE_*_API_TOKEN or
# SESSION_SECRET_* values; provisioning saves their newly generated values.
# For an existing authorized public repository only:
# CF_VIDEO_ALLOW_PUBLIC_REPOSITORY=true
